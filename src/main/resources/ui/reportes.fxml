<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ui.ReportesController" spacing="14" styleClass="pagina">
   <padding><Insets top="24" right="28" bottom="20" left="28"/></padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="10">
         <children>
            <VBox spacing="2" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="Reportes" styleClass="titulo-seccion"/>
                  <Label text="Genera reportes del hotel y guárdalos para abrirlos en Excel." styleClass="pagina-subtitulo"/>
               </children>
            </VBox>
            <Button text="Guardar en Excel (CSV)" styleClass="boton-oscuro" prefHeight="38" onAction="#exportar">
               <graphic><Region styleClass="ico, ico-pequeno, ico-descargar" style="-fx-background-color: #eab252;"/></graphic>
            </Button>
         </children>
      </HBox>

      <HBox spacing="12" alignment="BOTTOM_LEFT" styleClass="tarjeta">
         <padding><Insets top="14" right="18" bottom="14" left="18"/></padding>
         <children>
            <VBox spacing="4"><children><Label text="Reporte" styleClass="campo-etiqueta"/><ComboBox fx:id="cmbReporte" prefWidth="210"/></children></VBox>
            <VBox spacing="4"><children><Label text="Desde" styleClass="campo-etiqueta"/><DatePicker fx:id="dpDesde" promptText="Inicio" prefWidth="140"/></children></VBox>
            <VBox spacing="4"><children><Label text="Hasta" styleClass="campo-etiqueta"/><DatePicker fx:id="dpHasta" promptText="Fin" prefWidth="140"/></children></VBox>
            <Button text="Quitar fechas" prefHeight="36" onAction="#quitarFechas"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Generar reporte" styleClass="boton-principal" prefHeight="36" onAction="#generar"/>
         </children>
      </HBox>

      <HBox styleClass="franja-resumen" alignment="CENTER_LEFT">
         <children><Label fx:id="lblResumen" styleClass="resumen" wrapText="true"/></children>
      </HBox>

      <HBox spacing="16" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="tblReporte" HBox.hgrow="ALWAYS">
               <placeholder><Label text="Genera un reporte para ver sus datos."/></placeholder>
               <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            </TableView>
            <VBox fx:id="cajaGrafico" styleClass="tarjeta" prefWidth="380" minWidth="300" maxWidth="420" visible="false" managed="false">
               <children>
                  <BarChart fx:id="grafico" legendVisible="false" animated="false" VBox.vgrow="ALWAYS">
                     <xAxis><CategoryAxis/></xAxis>
                     <yAxis><NumberAxis/></yAxis>
                  </BarChart>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
