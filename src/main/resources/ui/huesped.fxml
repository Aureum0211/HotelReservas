<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<!-- Zona de huespedes: pequena plataforma de reservas (heroe + busqueda + tarjetas de habitaciones). -->
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ui.HuespedController" styleClass="fondo" prefWidth="1120" prefHeight="720">
   <top>
      <VBox>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="barra">
               <padding><Insets top="8" right="20" bottom="8" left="16"/></padding>
               <children>
                  <ImageView fitHeight="44" preserveRatio="true" smooth="true"><image><Image url="@images/logo_hr.png"/></image></ImageView>
                  <Label text="Zona de huéspedes" styleClass="barra-titulo" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                  <Button text="Volver al inicio" styleClass="boton-barra" onAction="#volver"/>
               </children>
            </HBox>
            <!-- Heroe: titulo + identificacion por documento (sin contrasena) -->
            <HBox spacing="24" alignment="CENTER_LEFT" styleClass="huesped-hero">
               <padding><Insets top="22" right="28" bottom="22" left="28"/></padding>
               <children>
                  <VBox spacing="6" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Reserva tu estadía" styleClass="huesped-hero-titulo"/>
                        <Label text="Elige tus fechas, encuentra una habitación libre y reserva en segundos." styleClass="huesped-hero-texto" wrapText="true"/>
                     </children>
                  </VBox>
                  <VBox spacing="6" styleClass="huesped-id" prefWidth="390" minWidth="300">
                     <children>
                        <Label text="YA SOY HUÉSPED · MI DOCUMENTO" styleClass="campo-etiqueta"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                           <children>
                              <TextField fx:id="txtDocumento" promptText="Número de documento" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                              <Button text="Ingresar" styleClass="boton-principal" onAction="#ingresar"/>
                           </children>
                        </HBox>
                        <Label fx:id="lblSaludo" styleClass="saludo" wrapText="true"/>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <VBox spacing="10">
         <padding><Insets top="18" right="28" bottom="16" left="28"/></padding>
         <children>
            <TabPane styleClass="pildoras" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
               <tabs>

                  <!-- ======================= BUSCAR Y RESERVAR ======================= -->
                  <Tab text="Buscar y reservar">
                     <content>
                        <VBox spacing="14">
                           <padding><Insets top="6" right="2" bottom="0" left="2"/></padding>
                           <children>
                              <HBox spacing="14" alignment="BOTTOM_LEFT" styleClass="busqueda-card">
                                 <children>
                                    <VBox spacing="4"><children><Label text="Entrada" styleClass="campo-etiqueta"/><DatePicker fx:id="dpEntrada" prefWidth="150"/></children></VBox>
                                    <VBox spacing="4"><children><Label text="Salida" styleClass="campo-etiqueta"/><DatePicker fx:id="dpSalida" prefWidth="150"/></children></VBox>
                                    <VBox spacing="4"><children><Label text="Personas" styleClass="campo-etiqueta"/><Spinner fx:id="spPersonas" min="1" max="10" initialValue="1" prefWidth="85"/></children></VBox>
                                    <Label fx:id="lblResumen" styleClass="resumen" wrapText="true" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                 </children>
                              </HBox>
                              <ScrollPane fitToWidth="true" styleClass="scroll-transparente" VBox.vgrow="ALWAYS">
                                 <content>
                                    <FlowPane fx:id="flpLibres" hgap="18" vgap="18">
                                       <padding><Insets top="4" right="8" bottom="14" left="4"/></padding>
                                    </FlowPane>
                                 </content>
                              </ScrollPane>
                              <Label text="Los descuentos por estadía larga o por categoría de cliente se aplican al confirmar. El pago se realiza en recepción." styleClass="nota" wrapText="true"/>
                           </children>
                        </VBox>
                     </content>
                  </Tab>

                  <!-- ======================= MIS RESERVAS ======================= -->
                  <Tab text="Mis reservas">
                     <content>
                        <VBox spacing="12">
                           <padding><Insets top="6" right="2" bottom="0" left="2"/></padding>
                           <children>
                              <HBox spacing="12" alignment="CENTER_LEFT">
                                 <children>
                                    <Label text="Tus reservas" styleClass="titulo-seccion"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="Si una reserva ya tiene pagos, la cancelación se hace en recepción." styleClass="nota"/>
                                    <Button text="Actualizar" onAction="#actualizarMisReservas">
                                       <graphic><Region styleClass="ico, ico-pequeno, ico-actualizar"/></graphic>
                                    </Button>
                                 </children>
                              </HBox>
                              <ScrollPane fitToWidth="true" styleClass="scroll-transparente" VBox.vgrow="ALWAYS">
                                 <content>
                                    <VBox fx:id="vbMisReservas" spacing="12">
                                       <padding><Insets top="4" right="8" bottom="14" left="4"/></padding>
                                    </VBox>
                                 </content>
                              </ScrollPane>
                           </children>
                        </VBox>
                     </content>
                  </Tab>

                  <!-- ======================= REGISTRARME ======================= -->
                  <Tab text="Registrarme">
                     <content>
                        <HBox alignment="TOP_CENTER">
                           <padding><Insets top="14" right="0" bottom="0" left="0"/></padding>
                           <children>
                              <VBox spacing="10" styleClass="tarjeta" maxWidth="520" prefWidth="520" maxHeight="-Infinity">
                                 <padding><Insets top="22" right="26" bottom="24" left="26"/></padding>
                                 <children>
                                    <Label text="¿Primera vez? Regístrate para poder reservar" styleClass="tarjeta-encabezado" wrapText="true"/>
                                    <GridPane hgap="14" vgap="10">
                                       <columnConstraints>
                                          <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                                          <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                                       </columnConstraints>
                                       <children>
                                          <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2"><children><Label text="Nombre completo" styleClass="campo-etiqueta"/><TextField fx:id="txtNombre"/></children></VBox>
                                          <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1"><children><Label text="Documento" styleClass="campo-etiqueta"/><TextField fx:id="txtDocRegistro"/></children></VBox>
                                          <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1"><children><Label text="Teléfono (10 dígitos)" styleClass="campo-etiqueta"/><TextField fx:id="txtTelefono"/></children></VBox>
                                          <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2"><children><Label text="Correo" styleClass="campo-etiqueta"/><TextField fx:id="txtCorreo"/></children></VBox>
                                          <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="2"><children><Label text="Ciudad" styleClass="campo-etiqueta"/><TextField fx:id="txtCiudad"/></children></VBox>
                                       </children>
                                    </GridPane>
                                    <Button text="Registrarme" styleClass="boton-principal, boton-ancho" maxWidth="Infinity" prefHeight="42" onAction="#registrarme">
                                       <VBox.margin><Insets top="6"/></VBox.margin>
                                    </Button>
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </content>
                  </Tab>

               </tabs>
            </TabPane>
         </children>
      </VBox>
   </center>
</BorderPane>
