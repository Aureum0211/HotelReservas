<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<!--
  Pantalla de inicio = marca + mascota + inicio de sesion.
  Los anchos de las tres columnas (33% / 30% / resto) se ajustan en BienvenidaController
  para que la pantalla se vea bien en cualquier tamano de ventana.
-->
<HBox fx:id="raiz" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ui.BienvenidaController">
   <children>

      <!-- Columna 1: marca -->
      <VBox fx:id="panelMarca" styleClass="panel-verde" spacing="16" minWidth="300">
         <padding><Insets top="34" right="34" bottom="22" left="40"/></padding>
         <children>
            <ImageView fitWidth="250" preserveRatio="true" smooth="true">
               <image><Image url="@images/logo_completo.png"/></image>
            </ImageView>
            <Label text="Gestión inteligente de reservas y huéspedes para hoteles, hostales y alojamientos."
                   styleClass="lema" wrapText="true"/>
            <VBox spacing="8">
               <padding><Insets top="10" right="0" bottom="0" left="0"/></padding>
               <children>
                  <Label text="•  Control de disponibilidad en tiempo real" styleClass="texto-claro"/>
                  <Label text="•  Registro de huéspedes" styleClass="texto-claro"/>
                  <Label text="•  Gestión de tarifas y reservas" styleClass="texto-claro"/>
                  <Label text="•  Reportes y estadísticas" styleClass="texto-claro"/>
               </children>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <Label text="Tu hotel," styleClass="lema"/>
            <Label text="mejor gestionado." styleClass="lema-dorado"/>
            <Label text="Edward Carrillo Martinez  ·  Prof. Alfredo Bautista  ·  Programación 3" styleClass="texto-claro-pequeno" wrapText="true"/>
         </children>
      </VBox>

      <!-- Columna 2: mascota (la imagen se recorta para llenar todo el panel) -->
      <StackPane fx:id="panelFoto" styleClass="panel-imagen" minWidth="220">
         <children>
            <ImageView fx:id="imgMascota" smooth="true" preserveRatio="false">
               <image><Image url="@images/mascota.jpg"/></image>
            </ImageView>
         </children>
      </StackPane>

      <!-- Columna 3: inicio de sesion -->
      <StackPane styleClass="fondo" minWidth="360" HBox.hgrow="ALWAYS">
         <children>
            <VBox alignment="CENTER" spacing="14" maxWidth="400" StackPane.alignment="CENTER">
               <padding><Insets topRightBottomLeft="30"/></padding>
               <children>
                  <Label text="Iniciar sesión" styleClass="titulo-login"/>
                  <Label text="Acceso para trabajadores del hotel" styleClass="nota"/>
                  <Region prefHeight="6"/>
                  <TextField fx:id="txtUsuario" promptText="Usuario" styleClass="campo-grande" maxWidth="Infinity"/>
                  <PasswordField fx:id="txtClave" promptText="Contraseña" styleClass="campo-grande" maxWidth="Infinity"/>
                  <Button text="Entrar" defaultButton="true" styleClass="boton-principal, boton-ancho"
                          prefHeight="46" maxWidth="Infinity" onAction="#entrar"/>
                  <Label fx:id="lblMensaje" styleClass="error" wrapText="true"/>
                  <HBox alignment="CENTER" spacing="12" styleClass="separador-o">
                     <children>
                        <Separator HBox.hgrow="ALWAYS"/>
                        <Label text="o" styleClass="nota"/>
                        <Separator HBox.hgrow="ALWAYS"/>
                     </children>
                  </HBox>
                  <Button text="Soy huésped" styleClass="boton-contorno" prefHeight="46" maxWidth="Infinity" onAction="#irHuesped"/>
                  <Label text="Sin contraseña: solo necesitas tu documento." styleClass="nota"/>
               </children>
            </VBox>
         </children>
      </StackPane>

   </children>
</HBox>
